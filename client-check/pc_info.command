#!/bin/bash

# ============================================================
# Практическая работа: диагностика клиентского компьютера (macOS)
# Автор: Игнаткин
# Дата: 26.10.2026
# ============================================================

# --- Работаем в папке, где лежит сам файл ---
cd "$(dirname "$0")" || exit 1
REPORT="$(pwd)/pc_report.txt"

# Всё, что внутри { ... }, выводится в окно и одновременно пишется в файл (tee)
{
# --- Заголовок ---
echo "=============================="
echo "   Диагностика компьютера"
echo "=============================="
echo "Дата: $(date '+%d.%m.%Y %H:%M')"
echo

# --- Операционная система ---
echo "Операционная система"
echo "------------------------------"
echo "Название: $(sw_vers -productName)"
echo "Версия: $(sw_vers -productVersion)"
echo

# --- Процессор ---
echo "Процессор"
echo "------------------------------"
sysctl -n machdep.cpu.brand_string
echo

# --- Оперативная память (переводим в ГБ) ---
echo "Оперативная память"
echo "------------------------------"
TOTAL_B=$(sysctl -n hw.memsize)
PAGE=$(vm_stat | awk '/page size of/ {print $8}')
FREE_PAGES=$(vm_stat | awk '/Pages free|Pages inactive|Pages speculative/ {gsub("\\.","",$NF); s+=$NF} END {print s}')
TOTAL_GB=$((TOTAL_B / 1073741824))
FREE_GB=$(awk -v p="$FREE_PAGES" -v s="$PAGE" 'BEGIN {printf "%.1f", p*s/1073741824}')
echo "Всего памяти: $TOTAL_GB ГБ"
echo "Свободно памяти: $FREE_GB ГБ"
echo

# --- Диск (переводим КБ в ГБ) ---
echo "Диск"
echo "------------------------------"
read -r DISK_TOTAL_KB DISK_FREE_KB < <(df -k "$HOME" | awk 'NR==2 {print $2, $4}')
echo "Всего: $((DISK_TOTAL_KB / 1048576)) ГБ"
echo "Свободно: $((DISK_FREE_KB / 1048576)) ГБ"
echo

# --- Установленные программы ---
echo "Установленные программы"
echo "------------------------------"
ls /Applications | grep '\.app$' | sed 's/\.app$//'
echo
} | tee "$REPORT"

# --- Сообщение о сохранении ---
echo "------------------------------"
echo "Отчёт сохранён"
echo

# --- Ждём нажатия клавиши, чтобы окно не закрылось сразу ---
read -n 1 -s -r -p "Нажмите любую клавишу для выхода..."
